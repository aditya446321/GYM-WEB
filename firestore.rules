rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() {
      return signedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : null;
    }
    function admin() { return role() == 'admin'; }
    function trainer() { return role() == 'trainer'; }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create, update: if signedIn() && (request.auth.uid == uid || admin());
      allow delete: if admin();
    }
    match /clients/{id} {
      allow read: if admin() || (signedIn() && (resource.data.userId == request.auth.uid || resource.data.trainerId == request.auth.uid));
      allow create, update, delete: if admin();
    }
    match /trainers/{id} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }
    match /memberships/{id} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }
    match /payments/{id} {
      allow read: if admin() || trainer() || (signedIn() && get(/databases/$(database)/documents/clients/$(resource.data.clientId)).data.userId == request.auth.uid);
      allow create, update, delete: if admin();
    }
    match /sessions/{id} {
      allow read: if admin() || trainer() || (signedIn() && resource.data.clientId == request.auth.uid);
      allow create: if admin() || trainer();
      allow update: if admin() || trainer();
      allow delete: if admin();
    }
    match /reviews/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if admin();
    }
  }
}
